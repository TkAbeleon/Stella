# Copier vers .env. NE JAMAIS commiter .env ni de secret réel.
APP_NAME=Stella API
# development | production  (en production : JWT fort obligatoire, simulateur et données de démo refusés)
APP_ENV=development
API_V1_PREFIX=/api/v1
# Cible : PostgreSQL. Pour un essai local sans PostgreSQL : sqlite:///./stella_dev.db
DATABASE_URL=postgresql+psycopg://stella_app:change-me@localhost:5432/stella
JWT_SECRET_KEY=replace-with-a-long-random-secret-before-running
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:8080

# --- Simulateur (mock de la partie électronique) : développement uniquement ---
SIMULATOR_ENABLED=true
SIMULATOR_DEVICE_ID=ge-ctrl-01

DEVICE_HEARTBEAT_INTERVAL_SECONDS=30
DEVICE_OFFLINE_AFTER_SECONDS=90
DEVICE_COMMAND_POLL_SECONDS=4
COMMAND_DEFAULT_TTL_SECONDS=60
# Durée pendant laquelle une commande livrée n'est pas re-livrée (bail)
COMMAND_LEASE_SECONDS=15
# true : refuse (503 DEVICE_OFFLINE) toute nouvelle commande si l'appareil est hors ligne
COMMANDS_REQUIRE_ONLINE=true

# --- Données de démonstration (APP_ENV=development uniquement) ---
# Mots de passe / clé de DÉMO, sans valeur de sécurité. Les remplacer ou mettre SEED_DEV_DATA=false.
SEED_DEV_DATA=true
SEED_ADMIN_PASSWORD=admin-dev-only
SEED_OPERATEUR_PASSWORD=operateur-dev-only
SEED_LECTURE_PASSWORD=lecture-dev-only
SEED_DEVICE_KEY=dev-device-key-ge-ctrl-01
